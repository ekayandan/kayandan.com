---
export interface Props {
  /** What the owner must supply. Rendered as "TODO: <text>". */
  label: string;
  /** "box" renders a block-level dashed slot (e.g. screenshot / avatar). */
  variant?: 'inline' | 'box';
  class?: string;
}
const { label, variant = 'inline', class: className } = Astro.props;
const Tag = variant === 'box' ? 'div' : 'span';
---

<Tag class:list={['placeholder', variant === 'box' && 'placeholder--box', className]} data-placeholder>
  <span class="placeholder-text">TODO: {label}</span>
  <slot />
</Tag>
