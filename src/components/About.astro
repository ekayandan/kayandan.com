---
import Section from './Section.astro';
import { profile } from '../data/profile';
import { logoSvg, type LogoKey } from '../data/logos';
// "{{logo:key}}" inside a paragraph becomes the company's small mark.
const paras = profile.about.map((p) => p.replace(/\{\{logo:(\w+)\}\}/g, (_, k) => logoSvg(k as LogoKey, 14)));
---

<Section id="about" title="About">
  <div class="about">
    {
      paras.map((p) => (
        <p class="prose" data-reveal>
          <Fragment set:html={p} />
        </p>
      ))
    }
  </div>
</Section>
